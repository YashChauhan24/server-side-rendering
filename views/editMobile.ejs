<html>
  <head>
    <title>Document</title>
    <style>
      .main-div {
        max-width: 500px;
      }
      .center {
        text-align: center;
      }
      .green {
        color: rgb(17, 216, 17);
      }
    </style>
  </head>
  <body>
    <div class="main-div">
      <div class="center"><h3>Edit Mobile</h3></div>
      <% if(typeof mobile !='undefined') {%>
      <form action="/mobile/<%=mobile._id%>" method="post">
        <table>
          <tr>
            <td><label for="mobileName">Mobile Name</label></td>
            <td>
              <input
                type="text"
                name="mobileName"
                value="<%=mobile.mobileName%>"
              />
            </td>
          </tr>
          <tr>
            <td><label for="mobileModel">Mobile Model</label></td>
            <td>
              <input
                type="text"
                name="mobileModel"
                value="<%=mobile.mobileModel%>"
              />
            </td>
          </tr>
          <tr>
            <td>
              <label for="mobileDiscription">Mobile Discription</label>
            </td>
            <td>
              <textarea name="mobileDiscription" cols="30" rows="3">
<%=mobile.mobileDiscription%></textarea
              >
            </td>
          </tr>
          <tr></tr>
          <tr>
            <td colspan="2" class="center">
              <input type="submit" name="savebtn" value="save Mobile" />
            </td>
          </tr>
        </table>
      </form>
      <%}else{%>
      <div>You have entered wrong mobile id or invalid URL</div>
      <%}%>
    </div>
  </body>
</html>
